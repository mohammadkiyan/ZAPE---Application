{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node", "react-native"],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",

    "expo-env.d.ts",
    "css-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
