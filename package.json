{
  "name": "zape-native",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.22.3"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:clean": "expo prebuild --clean --platform all --no-install",
    "bundle:android": "expo export:embed --platform android --dev false --bundle-output /tmp/zape-android.bundle --assets-dest /tmp/zape-android-assets",
    "bundle:ios": "expo export:embed --platform ios --dev false --bundle-output /tmp/zape-ios.bundle --assets-dest /tmp/zape-ios-assets",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "deps:check": "expo install --check",
    "doctor": "expo-doctor",
    "ui:doctor": "pnpm dlx @react-native-reusables/cli@0.7.1 doctor --summary --yes",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run deps:check && pnpm run doctor && pnpm run ui:doctor"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/vazirmatn": "^0.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "lucide-react-native": "^1.48.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "expo-doctor": "^1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
