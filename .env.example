# Android emulator: http://10.0.2.2:<port>; iOS simulator: http://localhost:<port>.
# Physical device: use a reachable LAN IP or HTTPS host. Never put secrets here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Development builds use the in-app mock backend when this is true or when no
# base URL is set. Release builds never use the mock.
# EXPO_PUBLIC_API_MOCK=true
